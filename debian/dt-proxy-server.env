# /etc/dt-proxy-server/dt-proxy-server.env
#
# Environment for the dt-proxy-server systemd service (EnvironmentFile).
# Lines starting with '#' are ignored. Variables set here OVERRIDE the values in
# /etc/dt-proxy-server/config.json. After editing run:
#     sudo systemctl restart dt-proxy-server
#
# --- Credentials -----------------------------------------------------------
# Optional. If you leave these unset, finish the one-time browser setup instead
# (see "First start" in the README); the key is then stored in
# /etc/dt-proxy-server/secrets.json (mode 0600).
# A key set here is used from memory and is never written to disk by the proxy.
#DEEPL_API_KEY=your-deepl-key:fx
# Fixed proxy token for Foundry (otherwise one is generated: dt_ + 43 characters).
#DT_PROXY_TOKEN=dt_replace_with_a_long_random_value

# --- Network ---------------------------------------------------------------
#PORT=3001
#HOST=127.0.0.1
# Exact Foundry origin(s), comma separated. Required when HOST is not loopback.
#ALLOWED_ORIGINS=http://localhost:30000

# --- Remote mode (behind an HTTPS reverse proxy) -----------------------------
#DT_PROXY_MODE=remote
#DT_PROXY_PUBLIC_URL=https://translate.example.com
#DT_PROXY_BEHIND_TRUSTED_PROXY=true
#DT_PROXY_TRUST_PROXY_HOPS=1

# --- Direct TLS (paths relative to /etc/dt-proxy-server unless absolute) ------
#DT_PROXY_TLS_ENABLED=true
#DT_PROXY_TLS_CERT=fullchain.pem
#DT_PROXY_TLS_KEY=privkey.pem

# --- Rate limits per window (0 disables a limit) -----------------------------
#DT_PROXY_RATE_TRANSLATE=180
#DT_PROXY_RATE_USAGE=240
#DT_PROXY_RATE_LANGUAGES=120
#DT_PROXY_RATE_GLOSSARIES=120
#DT_PROXY_RATE_DEFAULT=60
#DT_PROXY_RATE_WINDOW_MS=60000

# --- Logging -----------------------------------------------------------------
# error | warn | info | debug
RUST_LOG=info
